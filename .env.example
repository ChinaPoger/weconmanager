# 复制为 .env 使用(已在 .gitignore)

# wecom-agent 依赖包位置。
# 不设则用 vendor/wecom-agent(submodule 固定版本),但那里没有已解密的数据库;
# 「以本人身份发消息」需要解密数据,所以通常指向本地 checkout:
WECOM_AGENT_HOME=/Users/cc/works/wecom-agent

# 监听地址/端口
WECOM_SVR_HOST=127.0.0.1
WECOM_SVR_PORT=8090

# 可选鉴权;留空则不鉴权(仅本地使用,勿暴露公网)
WECOM_SVR_API_TOKEN=

# ── 新机器启动门禁 ─────────────────────────────────────────────────────
# 默认在端口开始提供服务前:
# 1. 验证并刷新本机 Info.db/Session.db;key 不可用时自动运行 find_key_fast.py
# 2. 打开再取消「发起群聊」面板,验证权限并校准本机 UI 偏移;
#    首次成功后生成 .data/ui_offsets.json
# 任一步失败都会阻止服务 ready,错误日志会给出处理方法。
WECOM_SVR_STARTUP_PREFLIGHT_ENABLED=true
WECOM_SVR_STARTUP_AUTO_INIT=true
WECOM_SVR_STARTUP_UI_CHECK=true
WECOM_SVR_STARTUP_KEY_TIMEOUT=180

# 自建应用凭证。留空时会回落到 $WECOM_AGENT_HOME/config.json
WECOM_CORPID=
WECOM_SECRET=
WECOM_AGENTID=

# 文档/表格端点依赖的外部 wecom-cli 二进制(需自行安装并 auth login)
WECOM_SVR_WECOM_CLI_PATH=wecom-cli
WECOM_SVR_ONLINE_TIMEOUT=60

# ── 群消息同步到 mars ─────────────────────────────────────────────────
# 留空 = 关闭。mars 的 hook 是公开路由,配错地址就是往生产灌数据,谨慎。
WECOM_SVR_MARS_BASE_URL=
# 要同步哪些群:群名或会话 RID,逗号分隔。**留空 = 一条都不同步**
# 候选列表: curl localhost:8090/api/v1/mars/sync/groups
WECOM_SVR_MARS_SYNC_GROUPS=
# 显式开启后同步本机所有群,会忽略上面的白名单(慎用)
WECOM_SVR_MARS_SYNC_ALL_GROUPS=false
# 后台常驻同步(false 时仍可用 POST /api/v1/mars/sync/run 手动跑)
WECOM_SVR_MARS_SYNC_ENABLED=false
# 轮询间隔(秒)。没有新数据时只是两次 stat,压到 2~3s 也不费什么
WECOM_SVR_MARS_SYNC_INTERVAL=3
# 图片消息最多等多少秒再推。企微收到图只写消息行,图片文件要等你点开会话才下载,
# 轮询几乎总是跑在下载前面 —— 不等就永远推 `[图片]` 占位符,而下游按正文算
# checksum,事后补推只会多出一条,没有回补的余地。
# 水位按群独立,等图只会推迟该群的后续消息,不会挡住其它群。
# 0 = 不等。
WECOM_SVR_MARS_IMAGE_WAIT=60
# 主动取图顺序:BigCDN 私有 TCP → 后台触发企微会话渲染。TCP 会话配置由抓包导入,
# 默认放在 gitignored 的 .data/media_tcp.json(0600),不要把其中 authkey 提交或打印。
WECOM_SVR_MARS_IMAGE_TCP_ENABLED=true
WECOM_SVR_MARS_IMAGE_TCP_CONFIG=.data/media_tcp.json
WECOM_SVR_MARS_IMAGE_TCP_TIMEOUT=8
WECOM_SVR_MARS_IMAGE_CLIENT_TRIGGER_ENABLED=true
WECOM_SVR_MARS_IMAGE_CLIENT_WAIT=8
WECOM_SVR_MARS_IMAGE_CLIENT_POLL=0.25
WECOM_SVR_MARS_IMAGE_TRIGGER_COOLDOWN=15
# 单条消息最多展示的图片数;多出的显示“另有 N 张未展示”
WECOM_SVR_MARS_IMAGE_MAX_PER_MESSAGE=9
# 首次同步往回补多少秒历史(0 = 只从当前最新一条往后,不倒灌)
WECOM_SVR_MARS_SYNC_BACKFILL=0
# mars 侧的群号前缀与来源标识,一般不用改
WECOM_SVR_MARS_GROUP_PREFIX=wework-
# 群名前缀默认留空;需要沿用 mars 的企微群命名约定时配置为 work-
WECOM_SVR_MARS_GROUP_NAME_PREFIX=
WECOM_SVR_MARS_ROBOT=wecom-svr

# ── 从 mars 拉任务(反向:mars 让本机发消息)────────────────────────────
# 设计见 docs/mars-task-queue.md。token 留空 = 整个功能关闭。
# 要和 mars.json 的 wecom_task_token 一致。
WECOM_SVR_MARS_TASKS_TOKEN=
# 后台常驻拉取(false 时仍可用 POST /api/v1/mars/tasks/run 手动跑一轮)
WECOM_SVR_MARS_TASKS_ENABLED=false
# 认领用的 worker 名。留空取本机 hostname;两台机器别用同一个名字
WECOM_SVR_MARS_TASKS_WORKER=
# ⚠️ 动作白名单。默认只允许「以应用身份发消息」。
# 不带 `app.` 前缀的那几条是**以你本人的身份说话**,让远端队列能驱动它,
# 权限边界大一个量级,要开必须显式写进来。"*" = 全开。
# 可选: app.message.send,message.send,group.create,group.rename
WECOM_SVR_MARS_TASKS_ACTIONS=app.message.send
# 长轮询秒数(上限 50,前面 nginx 的 read timeout 默认 60)
WECOM_SVR_MARS_TASKS_WAIT=25
# 一次领几条。默认 1:执行是串行的,批量领会让队尾任务的租约先过期
WECOM_SVR_MARS_TASKS_MAX=1
# 租约秒数,要盖住最慢的操作(拉群要逐个搜成员,可能几十秒)
WECOM_SVR_MARS_TASKS_LEASE=120
# 出错后歇多久再拉;正常轮次不 sleep(长轮询自己就是节流)
WECOM_SVR_MARS_TASKS_IDLE=3

# ── 界面坐标(仅「以本人身份」操控客户端时用得上)──────────────────────
# 会话列表顶部的 "+" 没有 AX 元素,只能按主窗口原点取偏移去点。
# 默认会在点不中时自己在附近校准,并把结果记进 .data/ui_offsets.json。
# 标题偏移只给旧版客户端使用;新版优先直接操作可写的 AX 标题控件。
# 客户端改版后要钉死某个位置,写 "x,y";配了就只用它,不再自动校准。
WECOM_SVR_UI_PLUS_OFFSET=
WECOM_SVR_UI_TITLE_OFFSET=
# 关掉自动校准:只点记住的那一个点,点不中直接报错
WECOM_SVR_UI_CALIBRATE=true

# ── 群图片落地(可选)──────────────────────────────────────────────────
# 不配则图片只推 [图片] 占位符。配了才会把本机企微缓存里的原图传到对象存储,
# 正文里附一个公网 URL,mars 前端才有东西可渲染。
# ⚠️ 目标 bucket 公开可读:图片传上去等于放到公网上,只是没人知道地址。
WECOM_SVR_KODO_AK=
WECOM_SVR_KODO_SK=
WECOM_SVR_KODO_BUCKET=
WECOM_SVR_KODO_DOMAIN=
WECOM_SVR_KODO_PREFIX=robot
